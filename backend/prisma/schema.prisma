generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String?
  googleId   String?  @unique
  avatarUrl  String?
  createdAt  DateTime @default(now())

  lists        ListMember[]
  historyItems HistoryItem[]
}

model List {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  members ListMember[]
  items   Item[]
}

model ListMember {
  id     String @id @default(uuid())
  userId String
  listId String

  user User @relation(fields: [userId], references: [id])
  list List @relation(fields: [listId], references: [id])

  @@unique([userId, listId])
}

model Item {
  id          String   @id @default(uuid())
  name        String
  category    String?
  quantity    Int      @default(1)
  unit        String?
  isPurchased Boolean  @default(false)
  listId      String
  createdAt   DateTime @default(now())

  list List @relation(fields: [listId], references: [id])
}

model HistoryItem {
  id          String   @id @default(uuid())
  itemName    String
  category    String?
  userId      String
  purchasedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}